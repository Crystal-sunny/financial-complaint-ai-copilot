# Server-only secret. Configure it through the hosting environment; never expose it to the client.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# BigModel standard API. Server-only; do not use the Coding Plan endpoint.
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.3-flash
# Optional server-side kill switch; consent is limited to the three approved cases.
GLM_CASE_DATA_PAUSED=false
