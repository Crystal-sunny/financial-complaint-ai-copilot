{
  "name": "financial-complaint-ai-copilot",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "eval": "node scripts/run-guardrail-evals.mjs",
    "eval:model-candidates": "node --env-file=.env.local scripts/verify-model-candidates.mjs",
    "test:offline": "node scripts/test-glm-provider.mjs && node scripts/test-case-data-policy.mjs && node scripts/test-glm-pipeline.mjs && node scripts/test-eval-fixtures.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint app components/case-workbench.tsx components/ui/accordion.tsx components/ui/badge.tsx components/ui/button.tsx components/ui/collapsible.tsx components/ui/input.tsx components/ui/popover.tsx components/ui/scroll-area.tsx lib",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/workers-types": "5.20260906.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.0"
  },
  "type": "module",
  "description": "Evidence-bound, approval-gated financial complaint AI collaboration demo"
}
