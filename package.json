{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "eval": "node scripts/run-guardrail-evals.mjs",
    "eval:model-candidates": "node --env-file=.env.local scripts/verify-model-candidates.mjs",
    "eval:model-summary": "node scripts/summarize-model-candidates.mjs",
    "eval:legacy": "node scripts/run-evals.mjs",
    "test:offline": "node scripts/test-glm-provider.mjs && node scripts/test-case-data-policy.mjs && node scripts/test-glm-pipeline.mjs && node scripts/test-eval-fixtures.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint app components/case-workbench.tsx components/ui/badge.tsx components/ui/button.tsx components/ui/input.tsx components/ui/popover.tsx components/ui/scroll-area.tsx lib",
    "format": "oxfmt"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react-day-picker": "9.8.1",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
